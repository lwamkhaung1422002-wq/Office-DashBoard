generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CATEGORY_ADMIN
  EDITOR
  VIEWER
}

enum AuditAction {
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_MOVED
  CATEGORY_ARCHIVED
  CATEGORY_RESTORED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  role         UserRole     @default(VIEWER)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  categories   Category[]   @relation("CategoryCreator")
  dataRecords  DataRecord[] @relation("DataRecordCreator")
  documents    Document[]   @relation("DocumentCreator")
  auditLogs    AuditLog[]
}

model Category {
  id          String       @id @default(cuid())
  name        String
  description String?
  sortOrder   Int          @default(0)
  parentId    String?
  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[]   @relation("CategoryHierarchy")
  archivedAt  DateTime?
  createdById String?
  createdBy   User?        @relation("CategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  dataRecords DataRecord[]
  documents   Document[]

  @@unique([parentId, name])
  @@index([parentId, archivedAt, sortOrder])
  @@index([archivedAt, name])
}

model DataRecord {
  id          String   @id @default(cuid())
  title       String
  payload     Json
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   User?    @relation("DataRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId, archivedAt])
}

model Document {
  id          String   @id @default(cuid())
  title       String
  fileName    String
  mimeType    String
  storageKey  String   @unique
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdById String?
  createdBy   User?    @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId, archivedAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String
  actorId    String?
  actor      User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  before     Json?
  after      Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}
