{
  "name": "office-dashboard-api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "lint": "eslint server tests",
    "typecheck": "tsc --noEmit",
    "build": "esbuild server/index.js --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "test": "vitest run tests",
    "test:e2e": "vitest run tests/backend.e2e.test.js",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test && npm run prisma:validate",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:status": "prisma migrate status --schema prisma/schema.prisma",
    "admin:create": "node server/scripts/create-admin.js",
    "trash:purge": "node server/scripts/purge-trash.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1135.0",
    "@prisma/client": "6.12.0",
    "bcryptjs": "3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "9.0.3",
    "multer": "^2.3.0",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prisma": "6.12.0",
    "supertest": "7.2.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
