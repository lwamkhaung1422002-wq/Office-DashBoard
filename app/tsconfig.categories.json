{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "noImplicitAny": false,
    "strict": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "skipLibCheck": true
  },
  "include": [
    "src/types.d.ts",
    "src/api.js",
    "src/categories/**/*.js",
    "src/categories/**/*.jsx"
  ]
}
